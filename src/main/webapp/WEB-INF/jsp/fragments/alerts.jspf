<%@ taglib prefix="c"  uri="http://java.sun.com/jsp/jstl/core" %>

<c:if test="${not empty flash}">
    <div class="alert alert-ok" role="status">
        <span class="alert-dot" aria-hidden="true"></span>
        <span class="alert-text"><c:out value="${flash}"/></span>
    </div>
</c:if>

<c:if test="${not empty error}">
    <div class="alert alert-error" role="alert">
        <span class="alert-dot" aria-hidden="true"></span>
        <span class="alert-text"><c:out value="${error}"/></span>
    </div>
</c:if>

<c:if test="${not empty unauthError}">
    <div class="alert alert-error" role="alert">
        <span class="alert-dot" aria-hidden="true"></span>
        <span class="alert-text"><c:out value="${unauthError}"/></span>
    </div>
</c:if>

<c:if test="${not empty info}">
    <div class="alert" role="status">
        <span class="alert-dot" aria-hidden="true"></span>
        <span class="alert-text"><c:out value="${info}"/></span>
    </div>
</c:if>