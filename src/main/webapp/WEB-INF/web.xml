<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0">

    <session-config>
        <tracking-mode>COOKIE</tracking-mode>
        <tracking-mode>URL</tracking-mode>
        <cookie-config>
            <name>JSESSIONID</name>
            <http-only>true</http-only>
        </cookie-config>
        <session-timeout>60</session-timeout>
    </session-config>

    <listener>
        <listener-class>com.javarush.apalinskiy.app.AppBootstrap</listener-class>
    </listener>

    <context-param>
        <param-name>uploads.dir</param-name>
        <param-value></param-value>
    </context-param>

    <servlet>
        <servlet-name>UserPublicProfileServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.UserPublicProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserPublicProfileServlet</servlet-name>
        <url-pattern>/user</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UserPublishedQuestsServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.UserPublishedQuestsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UserPublishedQuestsServlet</servlet-name>
        <url-pattern>/user/quests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminModerationGraphServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.AdminModerationGraphServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminModerationGraphServlet</servlet-name>
        <url-pattern>/quests/moderation/preview</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminQuestsModerationServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.AdminQuestsModerationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminQuestsModerationServlet</servlet-name>
        <url-pattern>/quests/moderation</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminUserEditServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.AdminUserEditServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminUserEditServlet</servlet-name>
        <url-pattern>/user/edit</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>friendsServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.FriendsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>friendsServlet</servlet-name>
        <url-pattern>/friends</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>notificationsServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.NotificationsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>notificationsServlet</servlet-name>
        <url-pattern>/notifications</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UsersServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.UsersServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UsersServlet</servlet-name>
        <url-pattern>/users</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ProfileServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.ProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ProfileServlet</servlet-name>
        <url-pattern>/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>UploadsServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.UploadsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>UploadsServlet</servlet-name>
        <url-pattern>/uploads/*</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DeleteQuestServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.DeleteQuestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DeleteQuestServlet</servlet-name>
        <url-pattern>/quest/delete</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AllCustomQuestsServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.AllCustomQuestsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AllCustomQuestsServlet</servlet-name>
        <url-pattern>/quests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>MyCustomQuestsServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.MyCustomQuestsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>MyCustomQuestsServlet</servlet-name>
        <url-pattern>/my/quests</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PublishServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.PublishServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PublishServlet</servlet-name>
        <url-pattern>/quest/publish</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GraphSvgServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.GraphSvgServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GraphSvgServlet</servlet-name>
        <url-pattern>/quest/graph_svg</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>CreateQuestServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.CreateQuestServlet</servlet-class>
        <multipart-config>
            <max-file-size>10485760</max-file-size>
            <max-request-size>20971520</max-request-size>
            <file-size-threshold>1048576</file-size-threshold>
        </multipart-config>
    </servlet>
    <servlet-mapping>
        <servlet-name>CreateQuestServlet</servlet-name>
        <url-pattern>/create_quest</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoSavesServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.GoSavesServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoSavesServlet</servlet-name>
        <url-pattern>/saves</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>GoSavesReadServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.GoLoadsServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>GoSavesReadServlet</servlet-name>
        <url-pattern>/loads</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>quest</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.QuestServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>quest</servlet-name>
        <url-pattern>/quest</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>home</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.HomeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>home</servlet-name>
        <url-pattern>/</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>logout</servlet-name>
        <servlet-class>com.javarush.apalinskiy.web.servlet.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>logout</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet-mapping>
        <servlet-name>default</servlet-name>
        <url-pattern>/assets/*</url-pattern>
    </servlet-mapping>

    <filter>
        <filter-name>EncodingFilter</filter-name>
        <filter-class>com.javarush.apalinskiy.web.filter.EncodingFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>EncodingFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>CurrentUserFilter</filter-name>
        <filter-class>com.javarush.apalinskiy.web.filter.CurrentUserFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CurrentUserFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>AdminOnlyFilter</filter-name>
        <filter-class>com.javarush.apalinskiy.web.filter.AdminOnlyFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AdminOnlyFilter</filter-name>
        <url-pattern>/user/edit</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AdminOnlyFilter</filter-name>
        <url-pattern>/quests/moderation</url-pattern>
    </filter-mapping>

    <filter>
        <filter-name>notificationsBadgeFilter</filter-name>
        <filter-class>com.javarush.apalinskiy.web.filter.NotificationsBadgeFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>notificationsBadgeFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <error-page>
        <error-code>404</error-code>
        <location>/WEB-INF/jsp/error_404.jsp</location>
    </error-page>
</web-app>